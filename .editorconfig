root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{sh,tsv}]
indent_style = tab

[*.md]
indent_style = space
indent_size = 2

[{*.yml,*.yaml}]
indent_style = space
indent_size = 2

[{bin/skillsync,install.sh,registry/generate.sh,tests/run.sh}]
indent_style = tab
